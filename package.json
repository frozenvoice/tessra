{
  "name": "arc-client",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "arc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arc/arc-client"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "rest",
    "api",
    "http",
    "https",
    "rest-client",
    "api-client",
    "request",
    "curl",
    "postman",
    "offline",
    "local-first",
    "collection",
    "environment",
    "api-testing"
  ],
  "activationEvents": [
    "onWebviewPanel:arc.requestPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "arc-client.historyMaxItems": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "%configuration.historyMaxItems.description%"
        },
        "arc-client.allowInsecureCertificates": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.allowInsecureCertificates.description%"
        },
        "arc-client.displayLanguage": {
          "type": "string",
          "scope": "window",
          "default": "en",
          "enum": [
            "en",
            "ko",
            "ja"
          ],
          "enumDescriptions": [
            "%configuration.displayLanguage.enum.en%",
            "%configuration.displayLanguage.enum.ko%",
            "%configuration.displayLanguage.enum.ja%"
          ],
          "description": "%configuration.displayLanguage.description%"
        }
      }
    },
    "commands": [
      {
        "command": "arc.newRequest",
        "title": "%command.newRequest%",
        "icon": "$(add)"
      },
      {
        "command": "arc.createCollection",
        "title": "%command.createCollection%",
        "icon": "$(new-folder)"
      },
      {
        "command": "arc.createFolder",
        "title": "%command.createFolder%",
        "icon": "$(new-folder)"
      },
      {
        "command": "arc.rename",
        "title": "%command.rename%"
      },
      {
        "command": "arc.delete",
        "title": "%command.delete%"
      },
      {
        "command": "arc.duplicateRequest",
        "title": "%command.duplicate%"
      },
      {
        "command": "arc.saveRequestAs",
        "title": "%command.saveAs%"
      },
      {
        "command": "arc.clearHistory",
        "title": "%command.clearHistory%",
        "icon": "$(clear-all)"
      },
      {
        "command": "arc.pinHistory",
        "title": "%command.pin%",
        "icon": "$(pin)"
      },
      {
        "command": "arc.unpinHistory",
        "title": "%command.unpin%",
        "icon": "$(pinned)"
      },
      {
        "command": "arc.deletePinnedHistory",
        "title": "%command.deletePinned%",
        "icon": "$(trash)"
      },
      {
        "command": "arc.createEnvironment",
        "title": "%command.createEnvironment%",
        "icon": "$(add)"
      },
      {
        "command": "arc.renameEnvironment",
        "title": "%command.rename%"
      },
      {
        "command": "arc.deleteEnvironment",
        "title": "%command.delete%"
      },
      {
        "command": "arc.editEnvironment",
        "title": "%command.editVariables%"
      },
      {
        "command": "arc.setActiveEnvironment",
        "title": "%command.setActive%",
        "icon": "$(pass-filled)"
      },
      {
        "command": "arc.deactivateEnvironment",
        "title": "%command.deactivate%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "arc.switchEnvironment",
        "title": "%command.switchEnvironment%"
      },
      {
        "command": "arc.changeDisplayLanguage",
        "title": "%command.changeDisplayLanguage%"
      },
      {
        "command": "arc.editDefaultHeaders",
        "title": "%command.defaultHeaders%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "arc.importCurl",
        "title": "%command.importCurl%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "arc.importCollection",
        "title": "%command.importCollection%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "arc.exportPostmanCollection",
        "title": "%command.exportPostmanCollection%"
      },
      {
        "command": "arc.exportPostmanEnvironment",
        "title": "%command.exportPostmanEnvironment%"
      },
      {
        "command": "arc.collapseAll",
        "title": "%command.collapseAll%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "arc.filterCollections",
        "title": "%command.filterCollections%",
        "icon": "$(search)"
      },
      {
        "command": "arc.clearCollectionFilter",
        "title": "%command.clearFilter%",
        "icon": "$(close)"
      },
      {
        "command": "arc.filterHistory",
        "title": "%command.filterHistory%",
        "icon": "$(search)"
      },
      {
        "command": "arc.clearHistoryFilter",
        "title": "%command.clearFilter%",
        "icon": "$(close)"
      },
      {
        "command": "arc.copyAsCurl",
        "title": "%command.copyAsCurl%"
      },
      {
        "command": "arc.runCollection",
        "title": "%command.runCollection%",
        "icon": "$(run-all)"
      },
      {
        "command": "arc.openGuide",
        "title": "%command.openGuide%",
        "icon": "$(book)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc-sidebar",
          "title": "%displayName%",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "arc-sidebar": [
        {
          "id": "arc.collections",
          "name": "%view.collections%"
        },
        {
          "id": "arc.environments",
          "name": "%view.environments%"
        },
        {
          "id": "arc.history",
          "name": "%view.history%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "arc.newRequest",
          "when": "view == arc.collections",
          "group": "navigation"
        },
        {
          "command": "arc.clearCollectionFilter",
          "when": "view == arc.collections && arc.collectionFilterActive",
          "group": "navigation"
        },
        {
          "command": "arc.filterCollections",
          "when": "view == arc.collections",
          "group": "navigation"
        },
        {
          "command": "arc.createCollection",
          "when": "view == arc.collections",
          "group": "navigation"
        },
        {
          "command": "arc.createEnvironment",
          "when": "view == arc.environments",
          "group": "navigation"
        },
        {
          "command": "arc.editDefaultHeaders",
          "when": "view == arc.environments",
          "group": "navigation"
        },
        {
          "command": "arc.importCurl",
          "when": "view == arc.collections",
          "group": "navigation"
        },
        {
          "command": "arc.createCollection",
          "when": "view == arc.collections",
          "group": "1_create@1"
        },
        {
          "command": "arc.importCollection",
          "when": "view == arc.collections",
          "group": "2_import@1"
        },
        {
          "command": "arc.importCurl",
          "when": "view == arc.collections",
          "group": "2_import@2"
        },
        {
          "command": "arc.collapseAll",
          "when": "view == arc.collections",
          "group": "3_collapse@1"
        },
        {
          "command": "arc.openGuide",
          "when": "view == arc.collections",
          "group": "4_help@1"
        },
        {
          "command": "arc.clearHistoryFilter",
          "when": "view == arc.history && arc.historyFilterActive",
          "group": "navigation"
        },
        {
          "command": "arc.filterHistory",
          "when": "view == arc.history",
          "group": "navigation"
        },
        {
          "command": "arc.clearHistory",
          "when": "view == arc.history",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "arc.createFolder",
          "when": "viewItem == collection || viewItem == folder",
          "group": "1_actions@1"
        },
        {
          "command": "arc.duplicateRequest",
          "when": "viewItem == request || viewItem == folder",
          "group": "1_actions@2"
        },
        {
          "command": "arc.saveRequestAs",
          "when": "viewItem == request || viewItem == folder",
          "group": "1_actions@3"
        },
        {
          "command": "arc.copyAsCurl",
          "when": "viewItem == request",
          "group": "1_actions@4"
        },
        {
          "command": "arc.exportPostmanCollection",
          "when": "viewItem == collection",
          "group": "1_actions@5"
        },
        {
          "command": "arc.runCollection",
          "when": "viewItem == collection || viewItem == folder",
          "group": "0_run@1"
        },
        {
          "command": "arc.rename",
          "when": "viewItem == collection || viewItem == folder || viewItem == request",
          "group": "2_edit@1"
        },
        {
          "command": "arc.delete",
          "when": "viewItem == collection || viewItem == folder || viewItem == request",
          "group": "2_edit@2"
        },
        {
          "command": "arc.setActiveEnvironment",
          "when": "viewItem == environment",
          "group": "0_active@1"
        },
        {
          "command": "arc.deactivateEnvironment",
          "when": "viewItem == environment-active",
          "group": "0_active@1"
        },
        {
          "command": "arc.renameEnvironment",
          "when": "viewItem == environment || viewItem == environment-active",
          "group": "1_edit@1"
        },
        {
          "command": "arc.deleteEnvironment",
          "when": "viewItem == environment || viewItem == environment-active",
          "group": "1_edit@2"
        },
        {
          "command": "arc.exportPostmanEnvironment",
          "when": "viewItem == environment || viewItem == environment-active",
          "group": "1_edit@3"
        },
        {
          "command": "arc.pinHistory",
          "when": "viewItem == history",
          "group": "inline"
        },
        {
          "command": "arc.unpinHistory",
          "when": "viewItem == history-pinned",
          "group": "inline"
        },
        {
          "command": "arc.deletePinnedHistory",
          "when": "viewItem == history-pinned",
          "group": "2_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "npx vsce package",
    "pretest": "tsc -p src/test/tsconfig.test.json",
    "test": "mocha dist/test/test/unit/**/*.test.js --timeout 10000",
    "test:unit": "mocha dist/test/test/unit/**/*.test.js --timeout 10000"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.20.0",
    "mocha": "^11.7.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
