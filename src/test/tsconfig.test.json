{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "../../dist/test",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "vscode": ["../../node_modules/@types/vscode"]
    }
  },
  "include": [
    "../**/*.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist"
  ]
}
